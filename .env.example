# Pega aquí tu clave NUEVA (sin espacios alrededor del = y sin comillas).
OPENAI_API_KEY=PEGA_AQUI_TU_NUEVA_CLAVE
OPENAI_MODEL=gpt-5.5
OPENAI_MAX_TOKENS=3000
# Solo para modelos de razonamiento (gpt-5.x, o-series). Quita el comentario si lo necesitas:
# OPENAI_REASONING_EFFORT=low

# Opcional: la IA de Anthropic que redacta el texto de cada rotación (si no se define, se usa una plantilla)
# ANTHROPIC_API_KEY=
